# Felix-Homelab 环境变量示例
#
# install.sh 会把本文件复制到 ~/.config/felix-homelab/.env，
# 并把其中的 CHANGE_ME 替换为随机生成的密码。
# 不要直接提交包含真实密码的 .env 到 Git。
#
# 命名规则：FORGEJO__<section>__<KEY> 会被 Forgejo 转换成 app.ini 配置，
# 详见 https://forgejo.org/docs/latest/admin/config-cheat-sheet/

# ----- PostgreSQL -----
POSTGRES_USER=forgejo
POSTGRES_DB=forgejo
POSTGRES_PASSWORD=CHANGE_ME

# ----- Forgejo: 数据库 -----
FORGEJO__database__DB_TYPE=postgres
FORGEJO__database__HOST=127.0.0.1:5432
FORGEJO__database__NAME=forgejo
FORGEJO__database__USER=forgejo
FORGEJO__database__PASSWD=CHANGE_ME

# ----- Forgejo: 服务器 -----
# 对外经阿里云 frp 中转（云侧 20022 -> 本机 2222），故为公网域名与端口
FORGEJO__server__DOMAIN=forgejo.wraindrock.com
FORGEJO__server__ROOT_URL=https://forgejo.wraindrock.com/
# SSH 用独立灰云域名（Cloudflare Tunnel 不转发 TCP；见 README）
FORGEJO__server__SSH_DOMAIN=ssh.wraindrock.com
FORGEJO__server__SSH_PORT=20022
FORGEJO__server__START_SSH_SERVER=true
FORGEJO__server__SSH_LISTEN_PORT=2222
FORGEJO__server__LFS_START_SERVER=true

# ----- Forgejo: 行为 -----
FORGEJO__service__DISABLE_REGISTRATION=false
FORGEJO__repository__DEFAULT_BRANCH=main
FORGEJO__actions__ENABLED=true

# 首次启动即自动完成安装与数据库迁移（跳过网页安装向导）。
# 第一个通过网页注册的账号将成为管理员。
FORGEJO__security__INSTALL_LOCK=true

# ----- 主站（Felix Homelab 社区站）-----
# 首次启动用它创建站长账号（后台 /admin 用）；密码 install.sh 会随机生成
ADMIN_USERNAME=Felix
ADMIN_PASSWORD=CHANGE_ME

# ----- 多租户 AI Agent（P1 试点）-----
# 模板镜像与每用户资源上限（宿主 scripts/agent-ctl.sh 使用）
AGENT_IMAGE=localhost/felix-agent-opencode:latest
AGENT_DSH_IMAGE=localhost/felix-agent-dsh:latest
# Agent 公开域名基域：实例域名形如 `<18位随机码>.wraindrock.com`（一级子域）
AGENT_BASE_DOMAIN=wraindrock.com
AGENT_LOCAL_DOMAIN=agent.localhost
AGENT_PORT_BASE=20001
AGENT_PORT_MAX=20099
AGENT_MEMORY=2g
AGENT_CPUS=1.5
AGENT_PIDS_LIMIT=512
# 空闲睡眠：无活动超过该秒数即停容器（打开时自动唤醒）；撤销后保留数据/域名天数
AGENT_IDLE_SECONDS=300
AGENT_GRACE_DAYS=30
# 定期重建容器（清可写层；数据卷/工作区保留）
AGENT_RECREATE_DAYS=7
# 模板镜像版本留存数（:latest 之外的版本标签，回滚用；agent-ctl.sh pin 切换）
AGENT_IMAGE_KEEP=3
# DSH 虚拟桌面 noVNC 端口基址（跨设备查看/操作容器内真实浏览器）
AGENT_VNC_PORT_BASE=21001
# 模板镜像内置版本（构建时固定，避免 latest 漂移）
OPENCODE_VERSION=2.0.18
# OpenCode 默认插件 agent-cache-optimizer：固定 fork（felix/opencode-v2）提交
AGENT_CACHE_OPTIMIZER_REF=CFG="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"
# 插件源码随镜像烤在 /opt（fork 固定提交）；但 OpenCode 的路径插件只加载
# 项目/家目录下的目录（/opt 会被静默跳过），因此按镜像版本戳种子到 $HOME 再引用。
SRC="/opt/agent-cache-optimizer"
PLUGIN="$HOME/.local/share/opencode-plugins/agent-cache-optimizer"
if [ -d "$SRC" ]; then
	want="$(cat "$SRC/.felix-rev" 2>/dev/null || echo unknown)"
	have="$(cat "$PLUGIN/.felix-rev" 2>/dev/null || echo none)"
	if [ "$want" != "$have" ] || [ ! -f "$PLUGIN/index.ts" ]; then
		rm -rf "$PLUGIN"
		mkdir -p "$(dirname "$PLUGIN")"
		cp -r "$SRC" "$PLUGIN"
	fi
fi
DSH_VERSION=0.1.7-rc.2
DSHMARKET_VERSION=1.66.3
# dsh-my-guardian：固定 fork（FelixHomelab/my-dsh-plugins）提交；改这里升级
DSHGUARDIAN_REF=1bca78ed0329fa921e447ea12eedbcf3990e1179
DSHCOSTMETER_VERSION=1.7.40
# opencode2dsh：固定 fork（FelixHomelab/opencode2dsh felix/configforms）提交
OPENCODE2DSH_REF=d5e866ae77b30d66212a7cfb87921a870a3bdc54
DSHBETTERSIDEBAR_VERSION=0.22.1
# ego 浏览器：固定 fork（FelixHomelab/dsh-ego-browser felix/main）提交；优化后改这里
DSHEGOBROWSER_REF=3fc4245d9b95b1eb2cfe540e32d04c363ba9ca31
# 无头引擎 Obscura 的版本（有头仍用 Chromium；升级时改这里）
OBSCURA_VERSION=v0.2.3
# dev-rules 走 git 分发（npm 无包名），固定提交 SHA；升级时换 main 最新 SHA
DSHDEV_RULES_REF=83c5ff329a1ecb9e8dc37da02eee17998f904dee

# Kanidm（统一账户）：管理员密码仅 CLI 使用（idm_admin），install.sh 会自动生成
KANIDM_ADMIN_PASSWORD=

# 主站 OIDC（Kanidm 机密客户端 site；install.sh 不生成，需从 Kanidm 获取后填入）
SITE_OIDC_CLIENT_ID=site
SITE_OIDC_SECRET=

# Cloudflare Tunnel：在 Zero Trust 里创建隧道后把连接器令牌填这里；
# 未填写前 install.sh 不会链接/启动 cloudflared 单元（与 frpc 同策略）
TUNNEL_TOKEN=

# OpenCloud（文件同步/分享，替代 Nextcloud）
# OC_URL 是公网地址（OIDC issuer 按它生成）；IDM_ADMIN_PASSWORD 在内置 IDM
# 首次初始化时生效，install.sh 会自动生成；之后改密码需重建配置卷（见 README）
OC_URL=https://opencloud.wraindrock.com
IDM_ADMIN_PASSWORD=

# Agent 子域 SSO：登录会话 cookie 覆盖父域，才能带进 <用户名>.agent.<域名>。
# 主站按请求 Host 自适应：localhost 不加 Domain（本地登录不受影响），
# *.wraindrock.com 才加；Secure 在非回环 Host 上自动启用。
COOKIE_DOMAIN=wraindrock.com
