# Felix-Homelab 环境变量示例
#
# install.sh 会把本文件复制到 ~/.config/felix-homelab/.env，
# 并把其中的 CHANGE_ME 替换为随机生成的密码。
# 不要直接提交包含真实密码的 .env 到 Git。
#
# 命名规则：FORGEJO__<section>__<KEY> 会被 Forgejo 转换成 app.ini 配置，
# 详见 https://forgejo.org/docs/latest/admin/config-cheat-sheet/

# ----- PostgreSQL -----
POSTGRES_USER=forgejo
POSTGRES_DB=forgejo
POSTGRES_PASSWORD=CHANGE_ME

# ----- Forgejo: 数据库 -----
FORGEJO__database__DB_TYPE=postgres
FORGEJO__database__HOST=127.0.0.1:5432
FORGEJO__database__NAME=forgejo
FORGEJO__database__USER=forgejo
FORGEJO__database__PASSWD=CHANGE_ME

# ----- Forgejo: 服务器 -----
# 对外经阿里云 frp 中转（云侧 20022 -> 本机 2222），故为公网域名与端口
FORGEJO__server__DOMAIN=forgejo.grantfelix.top
FORGEJO__server__ROOT_URL=https://forgejo.grantfelix.top/
FORGEJO__server__SSH_DOMAIN=forgejo.grantfelix.top
FORGEJO__server__SSH_PORT=20022
FORGEJO__server__START_SSH_SERVER=true
FORGEJO__server__SSH_LISTEN_PORT=2222
FORGEJO__server__LFS_START_SERVER=true

# ----- Forgejo: 行为 -----
FORGEJO__service__DISABLE_REGISTRATION=false
FORGEJO__repository__DEFAULT_BRANCH=main
FORGEJO__actions__ENABLED=true

# 首次启动即自动完成安装与数据库迁移（跳过网页安装向导）。
# 第一个通过网页注册的账号将成为管理员。
FORGEJO__security__INSTALL_LOCK=true

# ----- 主站（Felix Homelab 社区站）-----
# 首次启动用它创建站长账号（后台 /admin 用）；密码 install.sh 会随机生成
ADMIN_USERNAME=Felix
ADMIN_PASSWORD=CHANGE_ME

# ----- 多租户 AI Agent（P1 试点）-----
# 模板镜像与每用户资源上限（宿主 scripts/agent-ctl.sh 使用）
AGENT_IMAGE=localhost/felix-agent-opencode:latest
AGENT_DSH_IMAGE=localhost/felix-agent-dsh:latest
AGENT_BASE_DOMAIN=agent.grantfelix.top
AGENT_LOCAL_DOMAIN=agent.localhost
AGENT_PORT_BASE=20001
AGENT_PORT_MAX=20099
AGENT_MEMORY=2g
AGENT_CPUS=1.5
AGENT_PIDS_LIMIT=512
# 空闲睡眠：无活动超过该秒数即停容器（打开时自动唤醒）；撤销后保留数据/域名天数
AGENT_IDLE_SECONDS=300
AGENT_GRACE_DAYS=30
# 定期重建容器（清可写层；数据卷/工作区保留）
AGENT_RECREATE_DAYS=7
# 模板镜像版本留存数（:latest 之外的版本标签，回滚用；agent-ctl.sh pin 切换）
AGENT_IMAGE_KEEP=3
# 模板镜像内置版本（构建时固定，避免 latest 漂移）
OPENCODE_VERSION=2.0.18
DSH_VERSION=0.1.7-rc.2
DSHMARKET_VERSION=1.66.3
DSHGUARDIAN_VERSION=0.4.4
DSHCOSTMETER_VERSION=1.7.40
OPENCODE2DSH_VERSION=0.3.3
DSHBETTERSIDEBAR_VERSION=0.22.1
DSHEGOBROWSER_VERSION=0.8.5
# dev-rules 走 git 分发（npm 无包名），固定提交 SHA；升级时换 main 最新 SHA
DSHDEV_RULES_REF=83c5ff329a1ecb9e8dc37da02eee17998f904dee

# Agent 子域 SSO：登录会话 cookie 覆盖父域，才能带进 <用户名>.agent.<域名>。
# 主站按请求 Host 自适应：localhost 不加 Domain（本地登录不受影响），
# *.grantfelix.top 才加；Secure 在非回环 Host 上自动启用。
COOKIE_DOMAIN=grantfelix.top
