# Felix-Homelab 统一入口（Caddy，宿主端口 5729）
#
# Caddy 与其它容器同处一个 Pod 的网络命名空间，因此用 127.0.0.1 互访。
#
#   http://localhost:5729/            -> 主站（Felix Homelab 社区站，Leptos）
#   http://forgejo.localhost:5729/    -> Forgejo
#   http://dash.localhost:5729/       -> Homepage 控制台
#   http://cloud.localhost:5729/      -> Nextcloud
#
# 经云服务器（阿里云）frp 中转时，云侧 Caddy 终止 TLS 并把 Host 原样透传：
#   https://grantfelix.top / home.grantfelix.top -> 主站
#   https://forgejo.grantfelix.top               -> Forgejo
#   https://dash.grantfelix.top                  -> Homepage 控制台
#   https://cloud.grantfelix.top                 -> Nextcloud
# 本机 Caddy 只走明文 HTTP（auto_https off），HTTPS 由云侧 Caddy 负责。

{
	auto_https off
	admin off
}

http://:8080 {
	encode zstd gzip

	# Forgejo
	@forgejo host forgejo.localhost forgejo.grantfelix.top
	handle @forgejo {
		reverse_proxy 127.0.0.1:3000
	}

	# Homepage 控制台（监听 Pod hostname，故用 hostname 访问）
	@dash host dash.localhost dash.grantfelix.top
	handle @dash {
		reverse_proxy felix-homelab:3001
	}

	# Nextcloud（容器内监听 80）
	@cloud host cloud.localhost cloud.grantfelix.top
	handle @cloud {
		reverse_proxy 127.0.0.1:80
	}

	# 多租户 AI Agent 已迁到独立网关（felix-homelab-agent-gateway，host 网络）：
	# Agent 各自在独立 bridge 网络里，Pod 内的 Caddy 到不了；
	# 每用户路由仍由 scripts/agent-ctl.sh 生成，由 Agent 网关消费。

	# 默认：主站首页
	handle {
		# 静态资源强制协商缓存：升级后浏览器必须回源校验，避免继续用旧 wasm/js
		@assets path /pkg/*
		header @assets Cache-Control "no-cache"
		reverse_proxy 127.0.0.1:8090
	}

	# 未来新增工作站工具时，在默认 handle 之前追加路由，例如：
	#
	# handle_path /jupyter/* {
	# 	reverse_proxy 127.0.0.1:8888
	# }
}
