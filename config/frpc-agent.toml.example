# Felix-Homelab: Agent 网关 frp 隧道配置（由 install.sh 自动从 frpc.toml 生成）
#
# 独立于主 frpc：主隧道在 Pod 内（web → Pod Caddy），本隧道在 host 网络，
# 把云侧 20081 转发到宿主回环的 Agent 网关 5740。
# serverAddr / serverPort / auth.token 与 frpc.toml 保持一致。

serverAddr = "CHANGE_ME"
serverPort = 8443

auth.method = "token"
auth.token = "CHANGE_ME"

transport.tls.enable = true

log.to = "console"
log.level = "info"

[[proxies]]
name = "agent-gateway"
type = "tcp"
localIP = "127.0.0.1"
localPort = 5740
remotePort = 20081
