# Felix-Workstation: Nextcloud 环境变量
#
# install.sh 会复制到 ~/.config/felix-workstation/nextcloud.env，
# 并把 CHANGE_ME 替换为随机密码。
#
# 数据库指向同一个 PostgreSQL 容器中的独立库 nextcloud（见 ensure-nextcloud-db.sh）

POSTGRES_HOST=127.0.0.1
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=CHANGE_ME

# 首次启动创建管理员
NEXTCLOUD_ADMIN_USER=Felix
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME

# 受信域名（空格分隔；含经 Caddy 的域名与直连端口）
NEXTCLOUD_TRUSTED_DOMAINS=localhost cloud.localhost 127.0.0.1 cloud.localhost:5729 127.0.0.1:5734

# 反向代理：Caddy 与 Nextcloud 同处 Pod，来源为回环
TRUSTED_PROXIES=127.0.0.1 169.254.1.2

# 经 Caddy 访问时对外显示的地址
OVERWRITEHOST=cloud.localhost:5729
OVERWRITEPROTOCOL=http
