# Felix-Homelab 多租户 Agent 模板镜像（OpenClaw）
#
# OpenClaw 是自托管 Gateway（多渠道 + 控制台 Web UI），网关与控制台同端口。
# 入口脚本按 AGENT_PORT/AGENT_TOKEN 生成 ~/.openclaw/openclaw.json 后前台运行。
# 构建：scripts/build-agent-image.sh openclaw
ARG OPENCLAW_VERSION=2026.9.7
FROM docker.io/library/node:24-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates git python3 python3-pip \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g "openclaw@${OPENCLAW_VERSION}" --allow-scripts=openclaw

# ---- FreeRide 技能与 CLI（官方仓库固定提交；烘焙到 /opt 供首启注册）----
# 上游：https://github.com/Shaivpidadi/FreeRide（扁平 Python 包 + SKILL.md）
ARG FREERIDE_REF=3ca969f6eeaed7940b3cd247b34811363331bce7
RUN mkdir -p /opt/openclaw-skills \
 && curl -fsSL "https://gh-proxy.com/https://github.com/Shaivpidadi/FreeRide/archive/${FREERIDE_REF}.tar.gz" -o /tmp/fr.tgz \
 && tar -xzf /tmp/fr.tgz -C /tmp \
 && mv "/tmp/FreeRide-${FREERIDE_REF}" /opt/openclaw-skills/free-ride \
 && rm -f /tmp/fr.tgz \
 && pip install --break-system-packages --no-cache-dir -e /opt/openclaw-skills/free-ride

ENV HOME=/data

COPY entrypoint.sh /usr/local/bin/felix-agent-entrypoint.sh
RUN chmod +x /usr/local/bin/felix-agent-entrypoint.sh

EXPOSE 18789
ENTRYPOINT ["/usr/local/bin/felix-agent-entrypoint.sh"]
