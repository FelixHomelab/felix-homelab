# Felix-Homelab 多租户 Agent 模板镜像（DeepSeek Harness 版）
#
#  构建：scripts/build-agent-image.sh dsh（或 make agent-build-dsh）
#
# 按官方方式部署（README：`npx @deepseek-ai/dsh web`）：
#   · fnm 管理 Node（官方 engines：^22.19.0 || >=24.0.0，这里固定 24）；
#   · corepack 开启 yarn / pnpm，并按官方仓库把 pnpm 对齐到 11.7.0；
#   · npm 全局安装 `@deepseek-ai/dsh`，版本用 DSH_VERSION 固定（勿用 latest）。
# 另：
#   · 构建期初始化 web profile（node_modules 是指向全局 dsh 依赖的符号链接）；
#   · 写入版本戳，入口脚本在镜像升级时刷新 profile（保留凭据/会话/设置）；
#   · DSH web 拒绝 0.0.0.0 且自带令牌登录，同 Pod 内由 Caddy 回环反代 + 网关鉴权。
ARG FEDORA_VERSION=44

# ---- 构建 felix-novnc（Go 单二进制替代 Python websockify）----
# 无第三方模块（纯标准库），不需要 GOPROXY；产物约 6MB，常驻内存比 websockify 低一个量级。
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION} AS novnc-build
RUN dnf install -y golang && dnf clean all
COPY novnc-server/ /src
RUN cd /src && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /felix-novnc .
COPY llm-relay/ /relay-src
RUN cd /relay-src && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /felix-llm-relay .

FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION}

USER root
RUN dnf install -y --setopt=install_weak_deps=False \
	bash \
	git \
	curl \
	jq \
	unzip \
	openssh-clients \
	python3 \
	make \
	which \
	tzdata \
	ca-certificates \
	chromium \
	xorg-x11-server-Xvfb \
	openbox \
	x11vnc \
	novnc \
	dbus-daemon \
	dbus-tools \
	mesa-libGLES \
	mesa-libEGL \
	mesa-dri-drivers \
	libglvnd-gles \
	google-noto-sans-cjk-fonts \
	google-noto-emoji-fonts \
	&& dnf clean all

# ---- fnm + Node 24（国内走 npmmirror 的 Node 发行镜像）----
# fnm 官网安装脚本域名（fnm.vercel.app）在国内不可达，改从 GitHub Release 安装；
# github.com 直连不稳时回退 gh-proxy，并给 curl 明确连接超时，避免构建卡死。
ARG FNM_VERSION=v1.39.0
ENV FNM_DIR=/opt/fnm
RUN set -eux; \
	url="https://github.com/Schniz/fnm/releases/download/${FNM_VERSION}/fnm-linux.zip"; \
	curl -fsSL --connect-timeout 15 --retry 2 -o /tmp/fnm.zip "$url" \
		|| curl -fsSL --connect-timeout 15 --retry 2 -o /tmp/fnm.zip "https://gh-proxy.com/$url"; \
	unzip -o /tmp/fnm.zip -d /usr/local/bin; \
	chmod 0755 /usr/local/bin/fnm; \
	rm -f /tmp/fnm.zip; \
	fnm --version; \
	fnm install 24 --node-dist-mirror https://npmmirror.com/mirrors/node; \
	fnm default 24
ENV PATH="/opt/fnm/aliases/default/bin:${PATH}"

# ---- corepack：开启 yarn / pnpm，并把准备好的版本烤进镜像 ----
# COREPACK_HOME 必须在构建期与运行期一致，否则运行时会重新下载
# “known good”版本（pnpm 12 / yarn 4），既慢又依赖外网。
ENV COREPACK_HOME=/opt/corepack
RUN corepack enable \
 && corepack prepare pnpm@11.7.0 --activate \
 && corepack prepare yarn@1.22.22 --activate \
 && pnpm -v && yarn -v

# npm/pnpm 走 npmmirror（国内网络下 registry.npmjs.org 经常中断，实测构建因此失败）；
# 该 ENV 一直保留到运行期，用户从插件市场装插件也会走镜像，更快更稳。
ENV npm_config_registry=https://registry.npmmirror.com

# ---- 官方方式安装 dsh（固定版本）----
# 注意：npm 11 起默认不执行依赖的安装脚本（allow-scripts 安全策略），
# 而 dsh 依赖的 spawn helper / koffi / node-pty 需要跑 install 脚本；
# 不放开会得到“装上了但功能缺失”的 DSH。
ARG DSH_VERSION=0.1.7-rc.2
RUN npm install -g \
	--allow-scripts=@deepseek-ai/dsh-subprocess-local,koffi,node-pty,@google/genai,protobufjs \
	"@deepseek-ai/dsh@${DSH_VERSION}" \
 && dsh --version

# ---- 远程与本地部署体验一致：解锁客户端“设置/提供商”特权面 ----
# 上游只在浏览器 host 为 localhost/127.x 时开放设置文档编辑；本平台用户各自
# 独立容器 + 网关鉴权，因此放开该客户端门控（服务端无校验）。补丁找不到目标
# 会构建失败，强制升级 DSH 时人工复核。
COPY unlock-remote-settings.py /tmp/unlock-remote-settings.py
RUN python3 /tmp/unlock-remote-settings.py && rm -f /tmp/unlock-remote-settings.py

# 独立 bridge 网络里允许绑 0.0.0.0（端口映射需要），门控变量由平台容器设置；
# 本机/其他部署仍保持 DSH 默认的拒绝行为。
COPY allow-nonloopback-host.py /tmp/allow-nonloopback-host.py
RUN python3 /tmp/allow-nonloopback-host.py && rm -f /tmp/allow-nonloopback-host.py

# ---- 构建期初始化 web profile 并验证真能服务（模板完整性的硬校验）----
ENV DSH_HOME=/opt/dsh-home
RUN set -eux; \
	dsh --profile web --dump-config >/dev/null; \
	dsh web --port 38642 --no-open > /tmp/dsh-init.log 2>&1 & \
	pid=$!; \
	for i in $(seq 1 90); do grep -q 'dsh web:' /tmp/dsh-init.log && break; sleep 1; done; \
	cat /tmp/dsh-init.log; \
	grep -q 'dsh web:' /tmp/dsh-init.log; \
	token=$(sed -n 's/.*token=//p' /tmp/dsh-init.log | head -1); \
	code=$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:38642/?token=$token"); \
	test "$code" = "303"; \
	kill "$pid" 2>/dev/null || true; \
	wait "$pid" 2>/dev/null || true; \
	test -f /opt/dsh-home/profiles/web/package.json

# 构建期与运行期 HOME 必须一致：pnpm 会把 store 路径写进 node_modules/.modules.yaml，
# 运行时 HOME=/data；构建若用默认 /root，运行时装插件会报 ERR_PNPM_UNEXPECTED_STORE。
ENV HOME=/data

# ---- 自带插件市场 dsh-market（官方安装方式，固定版本）----
# https://github.com/dsh-market/dsh-market  →  open Settings → Plugin Market
ARG DSHMARKET_VERSION=1.66.3
RUN dsh plugin --profile web add "dshmarket@${DSHMARKET_VERSION}" \
 && test -f /opt/dsh-home/profiles/web/node_modules/dshmarket/package.json \
 && grep -q 'dshmarket' /opt/dsh-home/profiles/web/package.json

# ---- 自带插件守护 dsh-my-guardian（候选区 + 失败隔离，防止装插件搞崩容器）----
# https://github.com/baosfeng/my-dsh-plugins/tree/main/plugins/dsh-my-guardian
# 官方要求：守护自己是看门狗，必须在名册里最先加载 → 装好后把它的 bundle 调到第一位
# 守护 0.4.4 会把宿主提供的 react peer 误报为缺失（上游 main 已修未发版），
# 构建期打精确补丁（幂等、带守卫）。
COPY patch-guardian-host-peers.py /tmp/patch-guardian-host-peers.py
ARG DSHGUARDIAN_VERSION=0.4.4
RUN dsh plugin --profile web add "dsh-my-guardian@${DSHGUARDIAN_VERSION}" --trust-lockfile \
 && test -f /opt/dsh-home/profiles/web/node_modules/dsh-my-guardian/package.json \
 && node -e "const fs=require('fs');const f='/opt/dsh-home/profiles/web/package.json';const d=JSON.parse(fs.readFileSync(f));const rest=d.dsh.profile.bundles.filter((x)=>x!=='dsh-my-guardian');d.dsh.profile.bundles=['dsh-my-guardian',...rest];fs.writeFileSync(f,JSON.stringify(d,null,2)+'\n')" \
 && node -e "const d=require('/opt/dsh-home/profiles/web/package.json');if(d.dsh.profile.bundles[0]!=='dsh-my-guardian')process.exit(1)" \
  && python3 /tmp/patch-guardian-host-peers.py

# ---- 自带费用统计 dsh-cost-meter（会话/模型成本、预算、余额与套餐额度）----
# https://github.com/Han-1413141/dsh-cost-meter
ARG DSHCOSTMETER_VERSION=1.7.40
RUN dsh plugin --profile web add "dsh-cost-meter@${DSHCOSTMETER_VERSION}" \
	&& test -f /opt/dsh-home/profiles/web/node_modules/dsh-cost-meter/package.json \
	&& grep -q '"dsh-cost-meter"' /opt/dsh-home/profiles/web/package.json

# ---- 自带 OpenCode Zen 免费模型 @opencode2dsh/dsh-plugin（无需 API key）----
# https://github.com/FishBottle7/opencode2dsh
# 依赖链 pi-ai 里的 @google/genai / protobufjs 构建脚本运行期不需要：先在
# workspace 里显式拒绝，pnpm 11 才会放行（否则 ERR_PNPM_IGNORED_BUILDS）。
ARG OPENCODE2DSH_VERSION=0.3.3
RUN if ! grep -q '^allowBuilds:' /opt/dsh-home/profiles/web/pnpm-workspace.yaml; then \
		printf '\nallowBuilds:\n  "@google/genai": false\n  protobufjs: false\n' \
			>> /opt/dsh-home/profiles/web/pnpm-workspace.yaml; \
	fi \
	&& dsh plugin --profile web add "@opencode2dsh/dsh-plugin@${OPENCODE2DSH_VERSION}" \
	&& test -f /opt/dsh-home/profiles/web/node_modules/@opencode2dsh/dsh-plugin/package.json \
	&& grep -q '"@opencode2dsh/dsh-plugin"' /opt/dsh-home/profiles/web/package.json \
	&& node -e "const d=require('/opt/dsh-home/profiles/web/package.json');if(d.dsh.profile.bundles[0]!=='dsh-my-guardian')process.exit(1)"

# DSH 0.1.7 移除了客户端 settingsScope 服务（改由 configForms 承担），而 0.3.3
# 仍把它列为硬性注入：web boot 会卡在 pending、整个界面起不来（上游 issue #20/#24，
# 修复 PR #23 未发版）。构建期把客户端迁到 configForms 的旧 scope 适配上；
# 上游发版后脚本自动跳过（见 patch-opencode2dsh-configforms.py）。
# 补丁脚本常驻镜像：运行期从插件市场安装/更新插件会跑 pnpm install，可能把
# 官方插件还原（实测装主题后就复现了），入口脚本每次启动都会幂等重打一遍。
COPY patch-opencode2dsh-configforms.py /usr/local/bin/patch-opencode2dsh-configforms.py
RUN python3 /usr/local/bin/patch-opencode2dsh-configforms.py /opt/dsh-home/profiles/web

# ---- 自带侧边栏工作台 dsh-better-sidebar（文件树/编辑器/文件变动/任务/侧边对话）----
# https://github.com/omdsh-dev/DSH-better-sidebar（要求 DSH 0.1.7-rc.1+，本镜像满足）
ARG DSHBETTERSIDEBAR_VERSION=0.22.1
RUN dsh plugin --profile web add "dsh-better-sidebar@${DSHBETTERSIDEBAR_VERSION}" \
	&& test -f /opt/dsh-home/profiles/web/node_modules/dsh-better-sidebar/package.json \
	&& grep -q '"dsh-better-sidebar"' /opt/dsh-home/profiles/web/package.json

# ---- 自带开发规则 dsh-dev-rules（右侧栏「开发规则」面板 + 系统提示注入）----
# https://github.com/Grant-Felix/dev-rules；npm 无可用包名，按官方方式用 git
# 来源分发（国内可用 Gitee 镜像）。固定到 main 的一个提交保证可复现；
# 升级时把 DSHDEV_RULES_REF 换成新的 SHA（见 .env）。
ARG DSHDEV_RULES_REF=83c5ff329a1ecb9e8dc37da02eee17998f904dee
# GitHub 直连不稳时回退 Gitee 镜像（同一提交）；都按官方方式固定版本
RUN (dsh plugin --profile web add "github:Grant-Felix/dev-rules#${DSHDEV_RULES_REF}" \
		|| dsh plugin --profile web add "git+https://gitee.com/Grant-Felix/dev-rules.git#${DSHDEV_RULES_REF}") \
	&& test -f /opt/dsh-home/profiles/web/node_modules/dsh-dev-rules/package.json \
	&& grep -q '"dsh-dev-rules"' /opt/dsh-home/profiles/web/package.json

# ---- 自带 ego 浏览器 dsh-ego-browser（ego_* 工具 + 实时观察窗）----
# https://github.com/Fisfzy/dsh-ego-browser；浏览器由镜像内置的 Fedora chromium
# 提供（插件自带 --no-sandbox wrapper 适配 root/容器；无内置浏览器插件不可用）。
ARG DSHEGOBROWSER_VERSION=0.8.5
RUN dsh plugin --profile web add "dsh-ego-browser@${DSHEGOBROWSER_VERSION}" \
	&& test -f /opt/dsh-home/profiles/web/node_modules/dsh-ego-browser/package.json \
	&& grep -q '"dsh-ego-browser"' /opt/dsh-home/profiles/web/package.json \
	&& chmod 0755 /opt/dsh-home/profiles/web/node_modules/dsh-ego-browser/bin/*.sh \
	&& node -e "const d=require('/opt/dsh-home/profiles/web/package.json');if(d.dsh.profile.bundles[0]!=='dsh-my-guardian')process.exit(1)"

# 容器化下市场的一键重启会替换容器主进程：用 --patch 覆盖层统一禁用（所有宿主版本都有效）
RUN printf '%s\n' \
	'# 容器内禁用市场的一键重启（重启由平台/管理员操作）' \
	'- id: dsh-market' \
	'  name: dshmarket' \
	'  config:' \
	'    allowRestart: false' \
	> /opt/dsh-home/agent-patch.yml

# 版本戳：包含市场/守护版本与 profile 修订号；任一变化都会触发入口脚本的
# 「非破坏合并」（保留用户自己装的插件、收藏与手改补丁）。合并逻辑/布局有改动时
# 把 PROFILE_REV 加一，确保老数据卷也会重新合并一次。
ARG PROFILE_REV=7
RUN printf '%s' "${DSH_VERSION}+market${DSHMARKET_VERSION}+guardian${DSHGUARDIAN_VERSION}+costmeter${DSHCOSTMETER_VERSION}+oc2dsh${OPENCODE2DSH_VERSION}+sidebar${DSHBETTERSIDEBAR_VERSION}+ego${DSHEGOBROWSER_VERSION}+devrules${DSHDEV_RULES_REF}+cfpatch2+r${PROFILE_REV}" > /opt/dsh-home/.dsh-image-version


COPY dsh-entry.sh /usr/local/bin/dsh-entry.sh
COPY dsh-merge-profile.py /usr/local/bin/dsh-merge-profile.py
COPY seed-dev-rules.py /usr/local/bin/seed-dev-rules.py
# 容器内虚拟桌面（有头 Chromium 的显示）与 ego 浏览器启动包装（私有 D-Bus + no-sandbox）
COPY --from=novnc-build /felix-novnc /usr/local/bin/felix-novnc
# OpenAI 兼容的模型中转（固化协议边界的原生实现）
COPY --from=novnc-build /felix-llm-relay /usr/local/bin/felix-llm-relay
COPY felix-desktop-start.sh /usr/local/bin/felix-desktop-start.sh
COPY felix-ego-chrome.sh /usr/local/bin/felix-ego-chrome.sh
RUN chmod 0755 /usr/local/bin/dsh-entry.sh /usr/local/bin/dsh-merge-profile.py \
	/usr/local/bin/seed-dev-rules.py /usr/local/bin/felix-desktop-start.sh \
	/usr/local/bin/felix-ego-chrome.sh /usr/local/bin/felix-novnc \
	/usr/local/bin/felix-llm-relay

# 运行态统一挂到 /data（命名卷），工作目录统一 /workspace（宿主 bind mount）。
# 注意：必须与 scripts/agent-ctl.sh 注入的环境变量保持一致。
ENV HOME=/data \
    DSH_HOME=/data/dsh \
    XDG_DATA_HOME=/data/.local/share \
    XDG_CONFIG_HOME=/data/.config \
    XDG_CACHE_HOME=/data/.cache
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/dsh-entry.sh"]
CMD ["web", "--host", "127.0.0.1", "--port", "3123", "--no-open"]
