[Unit]
Description=Felix-Homelab: Agent 网关 frp 隧道（20081 → 网关 5740）
After=felix-homelab-pod.service
Wants=felix-homelab-pod.service

[Container]
ContainerName=felix-homelab-agent-frpc
Image=docker.io/snowdreamtech/frpc:0.71.0-alpine
# host 网络：隧道必须到达宿主回环上的 Agent 网关
Network=host
Timezone=local
Volume=%h/.config/felix-homelab/frp/frpc-agent.toml:/etc/frp/frpc.toml:ro,Z

[Service]
Restart=always

[Install]
WantedBy=default.target
