[Unit]
Description=Felix-Homelab: 容器健康自愈（autoheal）
After=felix-homelab-pod.service
Requires=felix-homelab-pod.service

[Container]
ContainerName=felix-homelab-autoheal
Image=docker.io/willfarrell/autoheal:latest
Pod=felix-homelab.pod
Timezone=local
# 只处理带 autoheal=true 标签的容器
Environment=AUTOHEAL_CONTAINER_LABEL=autoheal
Environment=AUTOHEAL_INTERVAL=30
Environment=AUTOHEAL_START_PERIOD=120
Volume=%t/podman/podman.sock:/var/run/docker.sock
SecurityLabelDisable=true

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
