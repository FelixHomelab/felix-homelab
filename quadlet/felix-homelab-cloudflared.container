[Unit]
Description=Felix-Homelab: Cloudflare Tunnel（公网入口，替代/补充云侧 Caddy）
Documentation=https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/
After=felix-homelab.pod.service felix-homelab-agent-gateway.service
Wants=felix-homelab-agent-gateway.service

[Container]
ContainerName=felix-homelab-cloudflared
Image=docker.io/cloudflare/cloudflared:latest
# host 网络：直接访问 127.0.0.1:5729（主 Caddy）与 127.0.0.1:5740（Agent 网关）
Network=host
EnvironmentFile=%h/.config/felix-homelab/.env
Exec=tunnel --no-autoupdate run

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
