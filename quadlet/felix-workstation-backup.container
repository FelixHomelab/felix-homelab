[Unit]
Description=Felix-Workstation: 备份执行环境（由 systemd timer 触发）
After=felix-workstation-pod.service felix-workstation-db.service felix-workstation-forgejo.service
Requires=felix-workstation-pod.service
Wants=felix-workstation-db.service felix-workstation-forgejo.service

[Container]
ContainerName=felix-workstation-backup
Image=codeberg.org/forgejo/forgejo:16
Pod=felix-workstation.pod
# 以容器内 root 运行：rootless 下映射为宿主用户，便于把归档写到宿主备份目录
User=0
Timezone=local
EnvironmentFile=%h/.config/felix-workstation/.env
Environment=BACKUP_DIR=/backups
Environment=BACKUP_CONF=/config/backup.conf
Environment=FORGEJO_CONFIG=/data/gitea/conf/app.ini
Environment=SITE_DIR=/site-data
Volume=felix-workstation-forgejo-data.volume:/data
Volume=felix-workstation-site-data.volume:/site-data
Volume=%h/.local/share/felix-workstation/backups:/backups
Volume=%h/.config/felix-workstation/backup/backup.sh:/usr/local/bin/backup.sh:ro
Volume=%h/.config/felix-workstation/sync:/config:ro
SecurityLabelDisable=true
# 常驻空闲容器，实际备份由 systemd timer 通过 podman exec 触发
Entrypoint=/bin/sleep
Exec=infinity

[Service]
Restart=always
TimeoutStartSec=300
# 等 Forgejo 就绪再启动，避免实例未安装时备份失败
ExecStartPre=/usr/bin/podman wait --condition=healthy felix-workstation-forgejo

[Install]
WantedBy=default.target
