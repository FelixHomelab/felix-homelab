[Unit]
Description=Felix-Workstation: Homepage 控制台（首页）
After=felix-workstation-pod.service
Requires=felix-workstation-pod.service

[Container]
ContainerName=felix-workstation-homepage
Image=ghcr.io/gethomepage/homepage:v2.4.0
Pod=felix-workstation.pod
Label=autoheal=true
Timezone=local
Environment=PORT=3001
Environment=HOMEPAGE_ALLOWED_HOSTS=localhost,localhost:5729,localhost:5732,127.0.0.1,127.0.0.1:5729,127.0.0.1:5732,dash.localhost,dash.localhost:5729,dash.grantfelix.top,dash.grantfelix.top:443
Environment=DOCKER_HOST=unix:///var/run/docker.sock
Volume=%h/.config/felix-workstation/homepage:/app/config
Volume=%h/.config/felix-workstation/homepage/icons:/app/public/icons:ro
Volume=%t/podman/podman.sock:/var/run/docker.sock
SecurityLabelDisable=true

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
