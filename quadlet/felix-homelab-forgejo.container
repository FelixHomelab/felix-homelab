[Unit]
Description=Felix-Homelab: Forgejo (Git 服务平台)
After=felix-homelab-pod.service felix-homelab-db.service
Requires=felix-homelab-pod.service felix-homelab-db.service

[Container]
ContainerName=felix-homelab-forgejo
Image=codeberg.org/forgejo/forgejo:16
Pod=felix-homelab.pod
Label=autoheal=true
EnvironmentFile=%h/.config/felix-homelab/.env
Environment=USER_UID=1000
Environment=USER_GID=1000
Timezone=local
Volume=felix-homelab-forgejo-data.volume:/data
HealthCmd=wget -q --spider http://127.0.0.1:3000/api/healthz
HealthInterval=15s
HealthTimeout=5s
HealthRetries=10
HealthStartPeriod=60s
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=300
# 等待 PostgreSQL 真正就绪（healthy）再启动 Forgejo，避免启动竞态
ExecStartPre=/usr/bin/podman wait --condition=healthy felix-homelab-db

[Install]
WantedBy=default.target
